  "devDependencies": {
    "@eslint/js": "9.30.0",
    "@playwright/test": "1.54.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.0.10",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.6.0",
    "eslint": "9.30.0",
    "eslint-plugin-i18next": "6.1.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
