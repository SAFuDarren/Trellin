{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model",
  "$defs": {
    "ModelRequest": {
      "type": "object",
      "required": [
        "model_id",
        "messages",
        "parameters",
        "budget"
      ],
      "properties": {
        "contract_version": {
          "const": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "role",
              "content"
            ],
            "properties": {
              "role": {
                "enum": [
                  "system",
                  "user",
                  "assistant",
                  "tool"
                ]
              },
              "content": {
                "type": "string"
              },
              "tool_call_id": {
                "type": "string",
                "minLength": 1
              },
              "tool_calls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "name",
                    "arguments"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "arguments": {
                      "type": "object"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "role": {
                      "const": "tool"
                    }
                  }
                },
                "then": {
                  "required": [
                    "tool_call_id"
                  ]
                }
              }
            ]
          },
          "minItems": 1
        },
        "parameters": {
          "type": "object"
        },
        "budget": {
          "type": "object",
          "required": [
            "wall_seconds",
            "max_attempts"
          ],
          "properties": {
            "wall_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "max_attempts": {
              "type": "integer",
              "minimum": 1
            },
            "max_model_calls": {
              "type": "integer",
              "minimum": 0
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "description",
              "input_schema"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "input_schema": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        },
        "response_schema": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "ModelResponse": {
      "type": "object",
      "required": [
        "provider",
        "requested_model",
        "model_id",
        "family",
        "output",
        "usage"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "requested_model": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "structured"
              ],
              "properties": {
                "structured": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "tool_calls"
              ],
              "properties": {
                "tool_calls": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "name",
                      "arguments"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "arguments": {
                        "type": "object"
                      }
                    },
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "usage": {
          "type": "object",
          "required": [],
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "cost_usd": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?$"
            }
          },
          "additionalProperties": false
        },
        "model_revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ModelRequest"
    },
    {
      "$ref": "#/$defs/ModelResponse"
    }
  ]
}
