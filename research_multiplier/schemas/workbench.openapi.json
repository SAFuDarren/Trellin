{
  "openapi": "3.1.0",
  "info": {
    "title": "Research Multiplier workbench API",
    "version": "1",
    "description": "Local workbench contract for claim views, Agent work reads and research issue previews."
  },
  "paths": {
    "/api/v1/workspaces/{workspace_id}/claims": {
      "get": {
        "operationId": "listRecentClaims",
        "summary": "List the selected workspace's recent frozen claims",
        "description": "Returns up to the 100 most recent visible frozen researcher claims, sorted by creation time (newest first) and then by ID. Archived and superseded claims are excluded. This pilot is a snapshot with no query parameters or pagination. The legacy /api/claims endpoint remains available with its existing response.",
        "security": [{ "LocalSession": [] }],
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "The selected workspace's claim snapshot.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/RequestId" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ClaimsList" } } }
          },
          "400": { "$ref": "#/components/responses/InvalidQuery" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/Failed" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/claims/{claim_id}/activity": {
      "get": {
        "operationId": "getClaimActivity",
        "summary": "Read proof activity on a claim in the selected workspace",
        "description": "Returns the same authorized snapshot as GET /api/activity?claim={claim_id}, with current proof job state, recorded outcomes, guidance and proof draft availability. This local-session read takes no query parameters and does not start a worker.",
        "security": [{ "LocalSession": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "claim_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Current claim activity and saved guidance.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/RequestId" } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["claim_id", "activity", "guidance", "guidance_available", "guidance_channels",
                    "guidance_reason", "guidance_blocker", "proof_draft_available"],
                  "properties": {
                    "claim_id": { "type": "string", "format": "uuid" },
                    "activity": {
                      "type": "array",
                      "maxItems": 60,
                      "items": {
                        "type": "object",
                        "required": ["id", "kind", "state", "text", "at", "node_id", "fallback_node_id"],
                        "properties": {
                          "id": { "type": "string" },
                          "kind": { "type": "string" },
                          "state": { "type": "string" },
                          "text": { "type": "string" },
                          "at": { "type": ["string", "null"], "format": "date-time" },
                          "node_id": { "type": "string" },
                          "fallback_node_id": { "type": "string" },
                          "policy_id": { "type": "string", "format": "uuid" },
                          "job_id": { "type": "string", "format": "uuid" },
                          "statement_id": { "type": "string", "format": "uuid" },
                          "attempt_id": { "type": "string", "format": "uuid" },
                          "provider": { "type": "string" },
                          "model": { "type": "string" },
                          "effort": { "type": "string" }
                        }
                      }
                    },
                    "guidance": {
                      "type": "array",
                      "maxItems": 40,
                      "items": {
                        "type": "object",
                        "required": ["id", "node_id", "text", "created_at", "submitted_at", "attempt_id",
                          "audience", "current_scope"],
                        "properties": {
                          "id": { "type": "string", "format": "uuid" },
                          "node_id": { "type": "string" },
                          "text": { "type": "string" },
                          "created_at": { "type": "string", "format": "date-time" },
                          "submitted_at": { "type": ["string", "null"], "format": "date-time" },
                          "attempt_id": { "type": ["string", "null"], "format": "uuid" },
                          "audience": { "type": "string" },
                          "current_scope": { "type": "boolean" }
                        }
                      }
                    },
                    "guidance_available": { "type": "boolean" },
                    "guidance_channels": { "type": "array", "items": { "type": "string" } },
                    "guidance_reason": { "type": "string" },
                    "guidance_blocker": { "type": ["string", "null"] },
                    "proof_draft_available": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ClaimActivityInvalidQuery" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/ClaimActivityNotFound" },
          "500": { "$ref": "#/components/responses/Failed" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/claims/{claim_id}/graph": {
      "get": {
        "operationId": "getClaimGraph",
        "summary": "Read the proof graph of a frozen claim in the selected workspace",
        "description": "Returns the same authorized snapshot as GET /api/graph?claim={claim_id}, with current proof nodes, dependencies, blockers and the verified ledger. This local-session read takes no query parameters and does not start a worker.",
        "security": [{ "LocalSession": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "claim_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Current proof graph and its recorded assurance history.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/RequestId" } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["claim", "nodes", "edges", "focus_id", "blockers", "ledger"],
                  "properties": {
                    "claim": {
                      "type": "object",
                      "required": ["id", "title", "statement", "statement_id", "status", "domain"],
                      "properties": {
                        "id": { "type": "string", "format": "uuid" },
                        "title": { "type": ["string", "null"] },
                        "statement": { "type": ["string", "null"] },
                        "statement_id": { "type": ["string", "null"], "format": "uuid" },
                        "status": { "type": "string" },
                        "domain": { "type": ["string", "null"] },
                        "code": { "type": "string" },
                        "lemma_plan_ready": { "type": "boolean" },
                        "premise_review": { "type": "object" }
                      }
                    },
                    "nodes": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["id", "kind", "status"],
                        "properties": {
                          "id": { "type": "string" },
                          "kind": { "type": "string" },
                          "status": { "type": ["string", "null"] },
                          "title": { "type": ["string", "null"] },
                          "statement": { "type": ["string", "null"] },
                          "formalization": { "type": ["string", "null"] },
                          "verification_status": { "type": "string" },
                          "reference": { "type": "object" },
                          "code": { "type": "string" }
                        }
                      }
                    },
                    "edges": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["source", "target", "kind"],
                        "properties": {
                          "source": { "type": "string" },
                          "target": { "type": "string" },
                          "kind": { "type": "string", "description": "Frozen scope, planned proof route or actual dependency." },
                          "relation": { "type": "string" }
                        }
                      }
                    },
                    "focus_id": { "type": "string" },
                    "blockers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["node_id", "kind", "reason"],
                        "properties": {
                          "node_id": { "type": "string" },
                          "kind": { "type": "string" },
                          "reason": { "type": "string" }
                        }
                      }
                    },
                    "ledger": {
                      "type": "object",
                      "required": ["lemmas", "tried_routes", "counts"],
                      "properties": {
                        "lemmas": {
                          "type": "array",
                          "maxItems": 40,
                          "items": {
                            "type": "object",
                            "required": ["lemma_id", "proposition", "verification_attempt_id", "recorded_at", "used_by"],
                            "properties": {
                              "lemma_id": { "type": "string", "format": "uuid" },
                              "proposition": { "type": "string" },
                              "verification_attempt_id": { "type": ["string", "null"], "format": "uuid" },
                              "recorded_at": { "type": ["string", "null"] },
                              "used_by": { "type": "array", "items": { "type": "string", "format": "uuid" } }
                            }
                          }
                        },
                        "tried_routes": {
                          "type": "array",
                          "maxItems": 16,
                          "items": {
                            "type": "object",
                            "required": ["implication_id", "status", "obligations", "open_obligation", "reason", "attempt_id", "recorded_at"],
                            "properties": {
                              "implication_id": { "type": "string", "format": "uuid" },
                              "status": { "type": "string" },
                              "obligations": { "type": "array", "maxItems": 8, "items": { "type": "string" } },
                              "open_obligation": { "type": ["string", "null"] },
                              "reason": { "type": ["string", "null"] },
                              "attempt_id": { "type": ["string", "null"], "format": "uuid" },
                              "recorded_at": { "type": ["string", "null"] }
                            }
                          }
                        },
                        "counts": {
                          "description": "Total counts before the display limits of the two arrays.",
                          "type": "object",
                          "required": ["lemmas", "tried_routes"],
                          "properties": {
                            "lemmas": { "type": "integer", "minimum": 0 },
                            "tried_routes": { "type": "integer", "minimum": 0 }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ClaimGraphInvalidQuery" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/ClaimGraphNotFound" },
          "500": { "$ref": "#/components/responses/Failed" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/research-issues/preview": {
      "post": {
        "operationId": "previewResearchIssue",
        "summary": "Prepare a research issue draft from a question or an exact private proof note",
        "description": "Requires a bound local researcher, a local session and the launcher Origin. Accepts up to 65,536 UTF-8 JSON bytes and no query parameters. Reads the researcher's current proof note when specified. Preview makes no writes or provider calls.",
        "security": [{ "LocalSession": [] }],
        "parameters": [
          { "name": "workspace_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "deliverable", "acceptance_criteria", "required_capabilities"],
                "oneOf": [
                  { "required": ["question"], "not": { "required": ["proof_note"] } },
                  { "required": ["proof_note"], "not": { "anyOf": [{ "required": ["question"] }, { "required": ["claim_id"] }] } }
                ],
                "properties": {
                  "title": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "\\S" },
                  "question": { "type": "string", "minLength": 1, "maxLength": 6000, "pattern": "\\S" },
                  "deliverable": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
                  "acceptance_criteria": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S" },
                  "claim_id": { "type": "string", "format": "uuid" },
                  "required_capabilities": {
                    "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
                    "items": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" }
                  },
                  "proof_note": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["claim_id", "node_id", "draft_revision"],
                    "properties": {
                      "claim_id": { "type": "string", "format": "uuid" },
                      "node_id": { "type": "string", "minLength": 1, "maxLength": 128 },
                      "draft_revision": { "type": "string", "format": "uuid" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A normalized draft and the exact source revision, when sourced from a proof note. Capability IDs are sorted.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/RequestId" } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["draft"],
                  "properties": {
                    "draft": {
                      "type": "object",
                      "required": ["title", "question", "deliverable", "acceptance_criteria",
                        "required_capabilities", "claim_id", "proof_note"],
                      "properties": {
                        "title": { "type": "string" },
                        "question": { "type": "string" },
                        "deliverable": { "type": "string" },
                        "acceptance_criteria": { "type": "string" },
                        "required_capabilities": {
                          "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
                          "items": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" }
                        },
                        "claim_id": { "type": ["string", "null"], "format": "uuid" },
                        "proof_note": {
                          "type": ["object", "null"],
                          "required": ["claim_id", "node_id", "draft_revision"],
                          "properties": {
                            "claim_id": { "type": "string", "format": "uuid" },
                            "node_id": { "type": "string" },
                            "draft_revision": { "type": "string", "format": "uuid" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ResearchIssueInvalid" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/ResearchIssueForbidden" },
          "404": { "$ref": "#/components/responses/ResearchIssueNotFound" },
          "409": { "$ref": "#/components/responses/ResearchIssueStale" },
          "500": { "$ref": "#/components/responses/Failed" },
          "503": { "$ref": "#/components/responses/ResearchIssueUnavailable" }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/research-issues": {
      "get": {
        "operationId": "listResearchIssues",
        "summary": "Read offered research Work and its current input status",
        "description": "Requires a bound local researcher and local session. Returns up to 100 of that researcher's most recent offers. Known changed or missing linked inputs require recheck. Unobservable inputs are separate. This list accepts no query parameters and does not change any stored offer, review or file.",
        "security": [
          {
            "LocalSession": []
          }
        ],
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Research Work list snapshot.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "items",
                    "next_cursor"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "maxItems": 100,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "direction",
                          "inputs",
                          "created_at",
                          "input_status"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "direction": {
                            "$ref": "#/paths/~1api~1v1~1workspaces~1{workspace_id}~1research-issues~1preview/post/responses/200/content/application~1json/schema/properties/draft"
                          },
                          "inputs": {
                            "type": "array",
                            "maxItems": 16,
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "source_id",
                                "reference_id",
                                "sha256"
                              ],
                              "properties": {
                                "source_id": {
                                  "type": "string",
                                  "format": "uuid"
                                },
                                "reference_id": {
                                  "type": "string",
                                  "format": "uuid"
                                },
                                "sha256": {
                                  "type": "string",
                                  "pattern": "^[0-9a-f]{64}$"
                                }
                              }
                            }
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "input_status": {
                            "type": "string",
                            "enum": [
                              "ready",
                              "needs_recheck",
                              "source_unavailable"
                            ]
                          }
                        }
                      }
                    },
                    "next_cursor": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ResearchIssueInvalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/ResearchIssueForbidden"
          },
          "404": {
            "$ref": "#/components/responses/ResearchIssueNotFound"
          },
          "500": {
            "$ref": "#/components/responses/Failed"
          },
          "503": {
            "description": "The research Work schema or workspace database is unavailable.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "offerResearchIssue",
        "summary": "Persist a research Work offer with exact linked-file inputs",
        "description": "Requires a bound local researcher, local session and the launcher Origin. A new offer verifies the specified registered file versions. Offering grants no execution and starts no provider call. Repeating an unchanged request with its UUID returns the original offer.",
        "security": [
          {
            "LocalSession": []
          }
        ],
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "direction"
                ],
                "properties": {
                  "direction": {
                    "$ref": "#/paths/~1api~1v1~1workspaces~1{workspace_id}~1research-issues~1preview/post/requestBody/content/application~1json/schema"
                  },
                  "inputs": {
                    "type": "array",
                    "maxItems": 16,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "reference_id",
                        "sha256"
                      ],
                      "properties": {
                        "reference_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{64}$"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "An immutable Work offer.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "issue"
                  ],
                  "properties": {
                    "issue": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "direction",
                        "inputs",
                        "created_at"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "direction": {
                          "$ref": "#/paths/~1api~1v1~1workspaces~1{workspace_id}~1research-issues~1preview/post/responses/200/content/application~1json/schema/properties/draft"
                        },
                        "inputs": {
                          "type": "array",
                          "maxItems": 16,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "source_id",
                              "reference_id",
                              "sha256"
                            ],
                            "properties": {
                              "source_id": {
                                "type": "string",
                                "format": "uuid"
                              },
                              "reference_id": {
                                "type": "string",
                                "format": "uuid"
                              },
                              "sha256": {
                                "type": "string",
                                "pattern": "^[0-9a-f]{64}$"
                              }
                            }
                          }
                        },
                        "created_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ResearchIssueInvalid"
          },
          "401": {
            "$ref": "#/components/responses/Unauthenticated"
          },
          "403": {
            "$ref": "#/components/responses/ResearchIssueForbidden"
          },
          "404": {
            "$ref": "#/components/responses/ResearchIssueNotFound"
          },
          "500": {
            "$ref": "#/components/responses/Failed"
          },
          "503": {
            "description": "The research Work schema or workspace database is unavailable.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          },
          "409": {
            "description": "A stale note or input, unavailable input, or conflicting idempotency key.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/RequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./error.schema.json"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/agent-work": {
      "get": {
        "operationId": "listAgentWork",
        "summary": "List Agent work for the local researcher in the selected workspace",
        "description": "Returns the same task summaries as GET /api/agent-work in a v1 list envelope, newest updates first, with task ID as a tie-breaker. Older databases without Agent work support return available=false and an empty list. This snapshot has no query parameters or pagination and does not start or wake a worker.",
        "security": [{ "LocalSession": [] }],
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Agent work list snapshot.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/RequestId" } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["items", "next_cursor", "available"],
                  "additionalProperties": false,
                  "properties": {
                    "next_cursor": { "type": "null", "description": "Always null for the list snapshot." },
                    "available": { "type": "boolean" },
                    "items": {
                      "type": "array",
                      "items": { "$ref": "./agent-work.schema.json#/$defs/TaskSummary" }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/AgentWorkInvalidQuery" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/AgentWorkForbidden" },
          "404": { "$ref": "#/components/responses/AgentWorkNotFound" },
          "500": { "$ref": "#/components/responses/Failed" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/api/v1/workspaces/{workspace_id}/agent-work/{task_id}": {
      "get": {
        "operationId": "getAgentWorkTask",
        "summary": "Read an Agent work task for the local researcher in the selected workspace",
        "description": "Returns the same authorized task detail as GET /api/agent-work?task={task_id}, including instructions, acceptance criteria, and any recorded delivery and review. This read takes no query parameters.",
        "security": [{ "LocalSession": [] }],
        "parameters": [
          {
            "name": "workspace_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized Agent work task detail.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/RequestId" } },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["task"],
                  "additionalProperties": false,
                  "properties": { "task": { "$ref": "./agent-work.schema.json#/$defs/TaskDetail" } }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/AgentWorkInvalidQuery" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "403": { "$ref": "#/components/responses/AgentWorkForbidden" },
          "404": { "$ref": "#/components/responses/AgentWorkNotFound" },
          "409": { "$ref": "#/components/responses/AgentWorkConflict" },
          "500": { "$ref": "#/components/responses/Failed" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    }
