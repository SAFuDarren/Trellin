{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification",
  "$defs": {
    "VerifyRequest": {
      "type": "object",
      "required": [
        "subject",
        "attempt_id",
        "artifact"
      ],
      "properties": {
        "subject": {
          "type": "object",
          "required": [
            "claim_id",
            "contract_sha256"
          ],
          "properties": {
            "claim_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "contract_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "artifact": {
          "type": "object",
          "required": [
            "uri",
            "sha256"
          ],
          "properties": {
            "uri": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        "audit_attempt_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "additionalProperties": false
    },
    "EvidenceReceipt": {
      "type": "object",
      "required": [
        "subject",
        "attempt_id",
        "kind",
        "verdict",
        "diff_status",
        "audit_mode",
        "artifact",
        "verifier",
        "provenance",
        "result"
      ],
      "properties": {
        "subject": {
          "type": "object",
          "required": [
            "claim_id",
            "contract_sha256"
          ],
          "properties": {
            "claim_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "contract_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "audit_attempt_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "kind": {
          "enum": [
            "numeric",
            "exact_certificate",
            "audited_proof",
            "lean",
            "counterexample"
          ]
        },
        "verdict": {
          "enum": [
            "verified",
            "rejected",
            "inconclusive"
          ]
        },
        "diff_status": {
          "enum": [
            "exact",
            "different",
            "undetermined"
          ]
        },
        "audit_mode": {
          "enum": [
            "none",
            "cross_family",
            "restricted_same_family"
          ]
        },
        "artifact": {
          "type": "object",
          "required": [
            "uri",
            "sha256"
          ],
          "properties": {
            "uri": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        "verifier": {
          "type": "object",
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "provenance": {
          "type": "object",
          "required": [
            "code_revision",
            "environment_sha256"
          ],
          "properties": {
            "code_revision": {
              "type": "string",
              "minLength": 1
            },
            "environment_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        "result": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "audit_mode": {
                "const": "none"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "audit_attempt_id"
              ]
            }
          },
          "else": {
            "required": [
              "audit_attempt_id"
            ]
          }
        }
      ]
    },
    "HumanReview": {
      "type": "object",
      "required": [
        "subject",
        "evidence_id",
        "action",
        "reason"
      ],
      "properties": {
        "subject": {
          "type": "object",
          "required": [
            "claim_id",
            "contract_sha256"
          ],
          "properties": {
            "claim_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "contract_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        "evidence_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "action": {
          "enum": [
            "approve",
            "return"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/VerifyRequest"
    },
    {
      "$ref": "#/$defs/EvidenceReceipt"
    },
    {
      "$ref": "#/$defs/HumanReview"
    }
  ]
}
